generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id               String            @id @default(cuid())
  externalId       String?           @unique
  name             String
  firstName        String?
  lastName         String?
  team             String?
  position         String
  status           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  salaries         PlayerSalary[]
  projections      PlayerProjection[]
  games            PlayerGameLog[]
  injuries         InjuryStatus[]
  usageSnapshots   UsageSnapshot[]
}

model Slate {
  id            String         @id @default(cuid())
  source        String
  season        Int
  week          Int
  slateDate     DateTime
  gameType      String
  salaryCap     Int            @default(50000)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  salaries      PlayerSalary[]
  projections   PlayerProjection[]
  games         Game[]

  @@unique([source, season, week, gameType])
}

model Game {
  id          String   @id
  slateId     String
  season      Int
  week        Int
  awayTeam    String
  homeTeam    String
  kickoff     DateTime?
  pointSpread Float?
  overUnder   Float?
  channel     String?
  status      String?

  slate       Slate    @relation(fields: [slateId], references: [id], onDelete: Cascade)

  @@index([slateId])
}

model PlayerSalary {
  id             String   @id @default(cuid())
  playerId       String
  slateId        String
  source         String
  salary         Int
  rosterPosition String
  isCaptain      Boolean? @default(false)
  collectedAt    DateTime @default(now())

  player         Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  slate          Slate  @relation(fields: [slateId], references: [id], onDelete: Cascade)

  @@unique([playerId, slateId, source])
  @@index([slateId])
}

model PlayerProjection {
  id                    String   @id @default(cuid())
  playerId              String
  slateId               String
  source                String
  projectedFantasyPoints Float
  floor                 Float?
  ceiling               Float?
  projectedRushYds      Float?
  projectedRushTds      Float?
  projectedRecYds       Float?
  projectedRecTds       Float?
  projectedPassYds      Float?
  projectedPassTds      Float?
  projectedTargets      Float?
  projectedSnaps        Float?
  projectedOwnership    Float?
  opponent              String?
  gameKey               String?
  modelVersion          String
  collectedAt           DateTime @default(now())

  player                Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  slate                 Slate  @relation(fields: [slateId], references: [id], onDelete: Cascade)

  @@unique([playerId, slateId, source])
  @@index([slateId])
}

model PlayerGameLog {
  id              String   @id @default(cuid())
  playerId        String
  season          Int
  week            Int
  opponentTeamId  String?
  passYds         Float?
  passTds         Float?
  rushYds         Float?
  rushTds         Float?
  recYds          Float?
  recTds          Float?
  targets         Float?
  receptions      Float?
  carries         Float?
  snaps           Float?
  fantasyPoints   Float
  createdAt       DateTime @default(now())

  player          Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model InjuryStatus {
  id          String   @id @default(cuid())
  playerId    String
  status      String
  description String?
  updatedAt   DateTime @updatedAt
  source      String

  player      Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model UsageSnapshot {
  id              String   @id @default(cuid())
  playerId        String
  season          Int
  week            Int
  snapShare       Float?
  targetShare     Float?
  redZoneTouches  Float?
  goalLineTouches Float?
  carryShare      Float?
  routeRate       Float?
  collectedAt     DateTime @default(now())

  player          Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}
